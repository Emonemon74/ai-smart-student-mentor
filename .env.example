# Copy to api/.env  (git-ignored). Every key from LLD C1.1.
DATABASE_URL=postgresql://emon:emon@localhost:5433/emon
PUBLIC_BASE_URL=http://localhost:3000        # scripts/dev.sh overwrites this with the tunnel URL
# API_PORT=8010                               # only if port 8000 is already taken on your machine
ADMIN_PASSWORD=change-me-please-12+chars      # >= 12 characters, startup fails otherwise
COUNSELLOR_PASSWORD=                          # optional: enables the counsellor staff role (>= 12 chars, differs from ADMIN_PASSWORD)

# Ordered LLM providers (first that answers wins). Use NON-reasoning chat models.
LLM_PROVIDERS=groq,gemini,openrouter,ollama
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_API_KEY=
GEMINI_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=

# Speech to text reuses the named provider's URL and key
STT_PROVIDER=groq
STT_MODEL=whisper-large-v3
